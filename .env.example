# Copy to .env for local runs. Never commit .env.
# Nextcloud → avatar → Personal settings → Security → Devices & sessions → Create new app password.

NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=

# Optional. Defaults shown.
# NEXTCLOUD_MAX_READ_BYTES=1048576
# NEXTCLOUD_MAX_WRITE_BYTES=10485760
# NEXTCLOUD_TIMEOUT_MS=30000

# Optional Streamable HTTP (`npm run mcp:http`). Loopback only unless a token is set.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8787
# MCP_HTTP_TOKEN=
